/dts-v1/;

#include "eic7700.dtsi"
#include "eic7700-pinctrl.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "pine64,starpro64", "eswin,eic7700";
	model = "Pine64 StarPro64";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		mmc0 = &sdhci_emmc;
		mmc1 = &sdio0;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	vcc_1v8: vcc1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

&osc {
	clock-frequency = <24000000>;
	clock-output-names = "osc_24m";
};

&pinctrl {
	vrgmii-supply = <&vcc_1v8>;
};

&gpio16_pins {
	input-disable;
	bias-disable;
};

&gpio94_pins {
	input-disable;
	bias-disable;
};

&gmac0 {
	phy-handle = <&gmac0_phy0>;
	phy-mode = "rgmii-id";
	pinctrl-names = "default";
	pinctrl-0 = <&gpio94_pins>;
	status = "okay";
};

&gmac0_mdio {
	gmac0_phy0: ethernet-phy@0 {
		reg = <0>;
		reset-gpios = <&gpioC 30 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <80000>;
	};
};

&gmac1 {
	phy-handle = <&gmac1_phy0>;
	/*
	 * Include the MAC's fixed 2 ns TX skew in the effective delay.
	 * The current driver subtracts it before programming the delay taps
	 * and disables the PHY TX delay through has_internal_tx_delay.
	 */
	phy-mode = "rgmii-id";
	pinctrl-names = "default";
	pinctrl-0 = <&gpio16_pins>;
	rx-internal-delay-ps = <700>;
	tx-internal-delay-ps = <2400>;
	status = "okay";
};

&gmac1_mdio {
	gmac1_phy0: ethernet-phy@0 {
		reg = <0>;
		reset-gpios = <&gpioA 16 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <80000>;
	};
};

&pcie {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&fan_pwm_pins>;
};

&sdhci_emmc {
	status = "okay";
	/*
	 * The eMMC data strobe pin is wired to RST on this board, so HS400
	 * (which requires a working data strobe) cannot work. Cap the eMMC
	 * at HS200 1.8V.
	 */
	/delete-property/ mmc-hs400-1_8v;
	mmc-hs200-1_8v;
};

&sdio0 {
	status = "okay";
	broken-cd;
	disable-wp;
};

&uart0 {
	status = "okay";
};

&usb0 {
	status = "okay";
};

&usb1 {
	status = "okay";
};
